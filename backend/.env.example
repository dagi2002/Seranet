NODE_ENV="production"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seranet?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT="4000"
CORS_ORIGIN="https://app.example.com"
UPLOADS_DIR="./uploads"
# Optional. Set this when uploads are served from a different public base URL
# such as a reverse proxy path, CDN, or object-storage-backed asset host.
UPLOADS_BASE_URL="https://api.example.com/uploads"
