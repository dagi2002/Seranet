NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seranet?schema=public"
JWT_SECRET="seranet-local-dev-secret"
PORT="4000"
CORS_ORIGIN="http://localhost:5173"
UPLOADS_DIR="./uploads"
